{
  "name": "issue-reporter",
  "version": "1.0.0",
  "private": true,
  "description": "Platform-global in-app issue intake backend and published client libraries",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "version:check": "node scripts/check-release.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release:check": "npm run version:check && npm run build && npm publish --workspaces --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1173.0",
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@stevenclarke/issue-reporter-core": "^1.0.0",
    "aws-jwt-verify": "^5.2.1",
    "octokit": "^5.0.5",
    "zod": "^4.6.7"
  }
}
