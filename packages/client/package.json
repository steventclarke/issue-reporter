{
  "name": "@steventclarke/issue-reporter-client",
  "version": "1.0.0",
  "description": "Framework-agnostic issue reporter client for tenant applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventclarke/issue-reporter.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@steventclarke/issue-reporter-core": "1.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean"
  }
}
